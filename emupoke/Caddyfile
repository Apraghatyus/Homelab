# Detras de Cloudflare Tunnel (o NPM): el HTTPS lo pone quien esta delante.
# COPIA DEL HOMELAB de deploy/Caddyfile (pokemeeting), con endurecimiento.
# Si el repo cambia sus rutas, hay que portar el cambio aqui (o subir esto al repo).
{
	auto_https off
	admin off
	servers {
		# Solo cloudflared (su IP fija en cloudflared-net) puede decir cual es la
		# IP real. NO usar la subred entera: el trafico que entra por :8790 llega
		# desde la puerta de enlace 192.168.128.1 y podria falsificar la cabecera.
		trusted_proxies static 192.168.128.2/32
		client_ip_headers Cf-Connecting-IP X-Forwarded-For
	}
}

:80 {
	encode gzip

	# Sin estas dos el nucleo del emulador arranca y falla en silencio.
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /signaling* {
		uri strip_prefix /signaling
		reverse_proxy {$SERVIDOR:emupoke-servidor}:8787
	}

	handle /cuentas* {
		request_body {
			max_size 1MB
		}
		uri strip_prefix /cuentas
		reverse_proxy {$SERVIDOR:emupoke-servidor}:8789 {
			# Sin esto el limite de intentos de login ve a TODO el mundo con la
			# IP de cloudflared y se convierte en un cupo global.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /randomizer* {
		request_body {
			max_size 64MB
		}
		uri strip_prefix /randomizer
		reverse_proxy {$SERVIDOR:emupoke-servidor}:8788 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
