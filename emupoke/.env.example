# Copiar a .env y rellenar. Permisos: chmod 600 .env
# Claves en HEX (openssl rand -hex 32): base64 mete / + = y rompe DATABASE_URL.
EMUPOKE_REPO=/home/apraghatyus/apps/pokemeeting
EMUPOKE_PORT=8790

# Superusuario: solo por socket dentro del contenedor, nunca por red.
EMUPOKE_PG_ADMIN_CLAVE=
# Rol de la aplicacion (dueno de la base emupoke, sin superusuario).
EMUPOKE_PG_APP_CLAVE=
# Rol de desarrollo: solo ve la base emupoke_dev.
EMUPOKE_PG_DEV_CLAVE=

# Acceso de desarrollo por Tailscale (servicio tunel-dev, perfil "dev").
EMUPOKE_PG_BIND=100.x.y.z
EMUPOKE_PG_PUERTO=5434
